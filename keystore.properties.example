# Release signing config for SENTINEL.
# Copy this file to "keystore.properties" (same directory) and fill in your values, then place your
# keystore at app/sentinel.jks. Both keystore.properties and *.jks are gitignored — never commit them.
# When these are absent, release builds automatically fall back to debug signing.

RELEASE_KEY_ALIAS=your_alias
RELEASE_KEY_PASSWORD=your_key_password
RELEASE_STORE_PASSWORD=your_store_password
