<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/activity_custom"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:openDrawer="start">

    <!-- ============================================================
         Fullscreen preview surface (camera, screen capture, or GoPro).
         Everything else floats on top via elevation.
         ============================================================ -->
    <com.pedro.library.view.OpenGlView
        android:id="@+id/openGlView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:aspectRatioMode="adjust"
        app:isFlipHorizontal="false"
        app:isFlipVertical="false" />

    <!-- Cover for screen-capture mode so we don't recursively render our own UI -->
    <FrameLayout
        android:id="@+id/screen_capture_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:elevation="6dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/screen_capture_active"
            android:textColor="@color/white"
            android:textSize="18sp" />
    </FrameLayout>

    <!-- Photo capture white flash -->
    <View
        android:id="@+id/white_color_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:elevation="9dp"
        android:visibility="invisible" />

    <!-- ============================================================
         TOUCH LOCK overlay. While visible, intercepts all touches so an accidental tap
         during a stream cannot stop the recording. The user releases the lock by
         long-pressing the centred badge for 2 s — handled in Camera2Fragment.
         ============================================================ -->
    <FrameLayout
        android:id="@+id/touch_lock_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#22000000"
        android:clickable="true"
        android:focusable="true"
        android:elevation="20dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/touch_lock_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp"
            android:background="@drawable/bg_chip_dark"
            android:longClickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/touch_lock_active_title"
                android:textColor="#FFE53935"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/touch_lock_unlock_hint"
                android:textColor="#FFFFFFFF"
                android:textSize="11sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- ============================================================
         TOP-LEFT CORNER: settings gear. Deliberately isolated from the
         control cluster (left strip + bottom record cluster) so it can't
         be hit by accident while operating the stream controls.
         ============================================================ -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/settingsButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="10dp"
        android:backgroundTint="#A6000000"
        app:tint="@android:color/white"
        app:rippleColor="#33FFFFFF"
        app:borderWidth="0dp"
        android:elevation="10dp"
        app:elevation="0dp"
        app:fabCustomSize="38dp"
        app:maxImageSize="18dp"
        app:srcCompat="@drawable/settings"
        android:contentDescription="@string/action_settings"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ============================================================
         TOP-CENTER: large state banner (also serves as the LIVE chip
         while streaming). Shows "Idle" / "Connecting…" / "LIVE 00:42".
         Centered so it sits clear of the settings gear and stats chip.
         ============================================================ -->
    <LinearLayout
        android:id="@+id/state_chip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_chip_dark"
        android:paddingStart="10dp"
        android:paddingEnd="14dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:layout_marginTop="10dp"
        android:elevation="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:id="@+id/state_dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/bg_status_dot"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/state_banner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/state_idle"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.04" />

        <!-- Elapsed time, only visible while streaming -->
        <TextView
            android:id="@+id/state_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="monospace"
            android:textColor="#FFCCCCCC"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- ============================================================
         TOP-RIGHT: compact stats chip (bitrate, FPS, drops).
         ============================================================ -->
    <LinearLayout
        android:id="@+id/stats_chip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_chip_dark"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="10dp"
        android:elevation="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/stream_path_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="my_path" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="2dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bitrate"
                android:textColor="#88FFFFFF"
                android:textSize="10sp"
                android:layout_marginEnd="4dp" />
            <TextView
                android:id="@+id/bitrate_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFFFF"
                android:textSize="10sp"
                android:fontFamily="monospace"
                tools:text="1024kb/s" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="2dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fps_label"
                android:textColor="#88FFFFFF"
                android:textSize="10sp"
                android:layout_marginEnd="4dp" />
            <TextView
                android:id="@+id/fps_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FF00FF6A"
                android:textSize="10sp"
                android:fontFamily="monospace"
                tools:text="30" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fps_drop_label"
                android:textColor="#88FFFFFF"
                android:textSize="10sp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="4dp" />
            <TextView
                android:id="@+id/fps_drop_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FF00FF6A"
                android:textSize="10sp"
                android:fontFamily="monospace"
                tools:text="0" />
        </LinearLayout>
    </LinearLayout>

    <!-- ============================================================
         RIGHT-EDGE: vertical icon strip (settings / more / switch / flash).
         Small, no border, just a translucent dark circle. Auto-hides after
         a few seconds of no touch.
         ============================================================ -->
    <LinearLayout
        android:id="@+id/right_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginStart="10dp"
        android:elevation="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/videoSource"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="3dp"
            android:backgroundTint="#A6000000"
            app:tint="@android:color/white"
            app:rippleColor="#33FFFFFF"
            app:borderWidth="0dp"
            android:elevation="0dp"
            app:elevation="0dp"
            app:fabCustomSize="38dp"
            app:maxImageSize="18dp"
            app:srcCompat="@drawable/three_dots_vertical" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/switch_camera"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="3dp"
            android:backgroundTint="#A6000000"
            app:tint="@android:color/white"
            app:rippleColor="#33FFFFFF"
            app:borderWidth="0dp"
            android:elevation="0dp"
            app:elevation="0dp"
            app:fabCustomSize="38dp"
            app:maxImageSize="18dp"
            app:srcCompat="@drawable/ic_switch_camera" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/flashlight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="3dp"
            android:backgroundTint="#A6000000"
            app:tint="@android:color/white"
            app:rippleColor="#33FFFFFF"
            app:borderWidth="0dp"
            android:elevation="0dp"
            app:elevation="0dp"
            app:fabCustomSize="38dp"
            app:maxImageSize="18dp"
            app:srcCompat="@drawable/flashlight_off" />

        <!-- Rotate the preview/stream orientation (landscape ↔ portrait). The preview adapts live
             and the chosen orientation is what the broadcast uses. -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/orientation_rotate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="3dp"
            android:backgroundTint="#A6000000"
            app:tint="@android:color/white"
            app:rippleColor="#33FFFFFF"
            app:borderWidth="0dp"
            android:elevation="0dp"
            app:elevation="0dp"
            app:fabCustomSize="38dp"
            app:maxImageSize="18dp"
            app:srcCompat="@drawable/rotation"
            android:contentDescription="@string/stream_orientation_title" />
    </LinearLayout>

    <!-- ============================================================
         BOTTOM-CENTER: record button, flanked by photo and orientation
         toggle. Record is a clean material FAB; the others are smaller.
         ============================================================ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottom_controls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:elevation="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/pictureButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#A6000000"
            app:tint="@android:color/white"
            app:rippleColor="#33FFFFFF"
            app:borderWidth="0dp"
            android:elevation="0dp"
            app:elevation="0dp"
            app:fabCustomSize="44dp"
            app:maxImageSize="22dp"
            app:srcCompat="@drawable/camera"
            android:layout_marginEnd="22dp"
            app:layout_constraintEnd_toStartOf="@id/b_start_stop"
            app:layout_constraintTop_toTopOf="@id/b_start_stop"
            app:layout_constraintBottom_toBottomOf="@id/b_start_stop" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/b_start_stop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#A6000000"
            app:backgroundTint="@color/WHITE"
            app:tint="#E53935"
            app:rippleColor="#55FFFFFF"
            app:borderWidth="0dp"
            android:elevation="6dp"
            app:elevation="6dp"
            app:fabCustomSize="64dp"
            app:maxImageSize="32dp"
            app:srcCompat="@drawable/ic_record"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ============================================================
         Zoom slider, just above the bottom cluster, narrow.
         ============================================================ -->
    <com.google.android.material.slider.Slider
        android:id="@+id/zoom_slider"
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:elevation="10dp"
        android:theme="@style/Theme.MaterialComponents.DayNight"
        android:stepSize="0"
        app:tickVisible="false"
        app:trackHeight="2dp"
        app:thumbRadius="5dp"
        app:thumbStrokeWidth="1dp"
        app:thumbStrokeColor="#FFFFFFFF"
        app:thumbColor="@color/appColor"
        app:haloRadius="14dp"
        app:haloColor="#22FFFFFF"
        app:tickColor="@color/appColor"
        app:trackColorActive="@color/appColor"
        app:trackColorInactive="#44FFFFFF"
        app:layout_constraintBottom_toTopOf="@id/bottom_controls"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ============================================================
         BOTTOM-LEFT: connection status badges (TAK server, location).
         Compact chips, visible during streaming.
         ============================================================ -->
    <LinearLayout
        android:id="@+id/status_badges"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="14dp"
        android:elevation="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/tak_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_chip_dark"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp">
            <View
                android:id="@+id/tak_dot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/bg_status_dot"
                android:layout_marginEnd="5dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tak_server"
                android:textColor="#FFFFFFFF"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/atak_connection_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textColor="#88FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/gps_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_chip_dark"
            android:layout_marginStart="6dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp">
            <View
                android:id="@+id/gps_dot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/bg_status_dot"
                android:layout_marginEnd="5dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/location_fix"
                android:textColor="#FFFFFFFF"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/location_fix_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textColor="#88FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rec_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_chip_dark"
            android:layout_marginStart="6dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp">
            <View
                android:id="@+id/rec_dot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/bg_status_dot"
                android:layout_marginEnd="5dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/recording"
                android:textColor="#FFFFFFFF"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/recording_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textColor="#88FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
